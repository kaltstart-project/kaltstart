EXIT_USAGE = 2      # usage or configuration error
EXIT_TOKEN = 3      # fido2 tools missing, no or ambiguous device, no usable secret
EXIT_SSH = 4        # ssh / transport error
EXIT_REJECTED = 5   # the server rejected the passphrase, did not read it or did not confirm it
EXIT_TIMEOUT = 6    # port never opened, or system did not come up

RETRY_INTERVAL = 2.0    # seconds between TCP connect attempts
CONNECT_TIMEOUT = 5.0   # seconds for a single TCP connect attempt
SECRET_LENGTH = 44      # base64 text of a 32-byte hmac-secret output
RELAY_GRACE = 5.0       # seconds to wait for the rest of ssh's error output
SESSION_LIMIT = 300.0   # seconds after which an ssh run without a terminal is ended
OUTPUT_LIMIT = 1 << 20  # bytes of remote output that are kept; a run that sends more is ended
LINE_LIMIT = 4096       # longer lines of ssh's error output are printed in pieces
TERMINATION_SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)
REDACTED = b"[passphrase removed]"
CRED_PROTECT_UV_REQUIRED = "3"  # credProtect level userVerificationRequired
CRYPTSETUP_NO_KEY = 2   # cryptsetup exit status: no keyslot opens with the passphrase
KEYSLOT_RE = re.compile(rb"Key slot ([0-9]+) unlocked")  # printed by cryptsetup --verbose
# Output of cryptroot-unlock (cryptsetup-initramfs) that unlock relies on:
UNLOCK_PROMPT = b"Please unlock disk"  # stdout, immediately before the passphrase is read
UNLOCK_GAVE_UP = b"Timeout reached while waiting for PID"  # stderr, cryptsetup still running after 10 s

VERBOSE = False


class Failure(Exception):
    """An expected failure with a one-line message and an exit code.

    The message must never contain the passphrase.
    """

    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def say(text):
    """Print a message. A terminal or pipe that has gone away must not stop the cleanup."""
    try:
        print(f"kaltstart: {text}", file=sys.stderr, flush=True)
    except OSError:
        pass


def show_command(argv):
    """Print a command line in verbose mode. Command lines never hold the secret."""
    if VERBOSE:
        say("run: " + shlex.join(argv))


def escape_control(text):
    """Make untrusted text safe for a terminal (one line, no control characters).

    The backslash is escaped as well, so that the result is unambiguous.
    """
    out = []
    for char in text:
        code = ord(char)
        if char == "\\":
            out.append("\\\\")
        elif char == " " or char.isprintable():
            out.append(char)
        elif code < 0x100:
            out.append(f"\\x{code:02x}")
        elif code < 0x10000:
            out.append(f"\\u{code:04x}")
        else:
            out.append(f"\\U{code:08x}")
    return "".join(out)


def b64(raw):
    return base64.b64encode(raw).decode("ascii")


# --------------------------------------------------------------------------
# Value validation. Every check takes the value and a "where" string that
# names section and key, and raises Failure(EXIT_USAGE) on bad input.
# --------------------------------------------------------------------------

NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")
HOST_RE = re.compile(r"[A-Za-z0-9:][A-Za-z0-9._:-]{0,252}")
USER_RE = re.compile(r"[A-Za-z_][A-Za-z0-9._-]{0,31}")
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f-\x9f]")
# Local paths end up in ssh options, where white space, quotes and % have a meaning.
UNSAFE_PATH_RE = re.compile(r"[\x00-\x20\x7f-\x9f\"'%#]")


def bad(where, problem):
    return Failure(EXIT_USAGE, f"{where}: {problem}")


def check_name(value, where):
    if not NAME_RE.fullmatch(value):
        raise bad(where, "invalid name (allowed: letters, digits, '.', '_', '-'; at most 64 characters)")
    return value


def check_host(value, where):
    if not HOST_RE.fullmatch(value):
        raise bad(where, "invalid host name or address")
    # The resolver refuses empty or over-long labels with a UnicodeError.
    # One trailing dot is fine.
    labels = value.split(".")
    if any(not 0 < len(label) < 64 for label in labels[:-1]) or len(labels[-1]) >= 64:
        raise bad(where, "invalid host name (empty label or label longer than 63 characters)")
    return value


def check_user(value, where):
    if not USER_RE.fullmatch(value):
        raise bad(where, "invalid user name")
    return value


def check_int(value, where, low, high):
    if not re.fullmatch(r"[0-9]{1,9}", value) or not low <= int(value) <= high:
        raise bad(where, f"must be an integer between {low} and {high}")
    return int(value)


def check_port(value, where):
    return check_int(value, where, 1, 65535)


def check_bool(value, where):
    lowered = value.lower()
    if lowered in ("1", "yes", "true", "on"):
        return True
    if lowered in ("0", "no", "false", "off"):
        return False
    raise bad(where, "must be yes or no")


def check_text(value, where):
    """A non-empty single-line string that cannot be mistaken for an option."""
    if not value or value != value.strip() or CONTROL_RE.search(value) or value.startswith("-"):
        raise bad(where, "must be a non-empty single-line value without surrounding white space "
                  "that does not start with '-'")
    return value


def check_local_path(value, where):
    """A local path for an ssh option. A relative path would depend on the current directory."""
    path = os.path.expanduser(value)
    if UNSAFE_PATH_RE.search(path):
        raise bad(where, "path must not contain white space, quotes, '%', '#' or control characters")
    if not os.path.isabs(path):
        raise bad(where, "must be an absolute path, or start with '~'")
    return path


def check_server_path(value, where):
    if not value.startswith("/") or CONTROL_RE.search(value):
        raise bad(where, "must be an absolute path on the server")
    return value


def check_b64(value, where, length=None):
    """Strict, canonical base64. Returns the decoded bytes."""
    try:
        raw = base64.b64decode(value.encode("ascii"), validate=True)
    except ValueError:  # includes binascii.Error and UnicodeEncodeError
        raise bad(where, "not valid base64") from None
    if not raw or b64(raw) != value:
        raise bad(where, "not valid base64")
    if length is not None and len(raw) != length:
        raise bad(where, f"must be base64 of exactly {length} bytes (got {len(raw)})")
    return raw


# The ssh options that ssh_options and admin_ssh_options may hold. A flag,
# unlike "-o", sets its option directly and would override the options this
# program forces, so only flags that cannot switch a forwarding or connection
# sharing on are accepted. Everything else is available through "-o".
SSH_FLAGS = "46Cqv"
SSH_FLAGS_WITH_ARGUMENT = "bBcEFiIJmoP"
SSH_FLAG_REASONS = {
    "A": "agent forwarding is switched off for this connection",
    "X": "X11 forwarding is switched off for this connection",
    "Y": "X11 forwarding is switched off for this connection",
    "M": "connection sharing is switched off for this connection",
    "S": "connection sharing is switched off for this connection",
    "O": "connection sharing is switched off for this connection",
    "p": "the port is set with its own key",
    "l": "the user is set with its own key",
}


def check_options(value, where):
    """Additional ssh arguments, split like a shell command line.

    Only the options named above and their arguments are accepted. Anything
    else would shift the destination and the remote command that follow on
    the command line, or undo an option that must not be overridden.
    """
    try:
        words = shlex.split(value)
    except ValueError as exc:
        raise bad(where, f"cannot be split into arguments ({exc})") from None
    argument_expected = False
    for word in words:
        if argument_expected:
            argument_expected = False
            continue
        if len(word) < 2 or not word.startswith("-") or word.startswith("--"):
            raise bad(where, f"'{escape_control(word)}' is neither an option of ssh nor the argument of one")
        for position, flag in enumerate(word[1:], start=2):
            if flag in SSH_FLAGS_WITH_ARGUMENT:
                argument_expected = position == len(word)  # otherwise the rest of the word is the argument
                break
            if flag not in SSH_FLAGS:
                reason = SSH_FLAG_REASONS.get(flag, "only -4 -6 -C -q -v and, with an argument, "
                                              "-b -B -c -E -F -i -I -J -m -o -P are accepted")
                raise bad(where, f"-{escape_control(flag)} is not allowed: {reason}")
    if argument_expected:
        raise bad(where, f"'{escape_control(words[-1])}' lacks its argument")
    return words


