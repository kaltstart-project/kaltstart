# Command line
# --------------------------------------------------------------------------

def seconds(text):
    value = float(text)
    if not 0 <= value <= 86400 * 365:  # also rejects NaN
        raise argparse.ArgumentTypeError("must be a number of seconds between 0 and 31536000 (one year)")
    return value


def build_parser():
    parser = argparse.ArgumentParser(
        prog="kaltstart",
        description="Unlock LUKS-encrypted servers over SSH with a FIDO2 token that stays on the workstation.")
    parser.add_argument("--config", metavar="PATH",
                        help="configuration file (default: $XDG_CONFIG_HOME/kaltstart/config.ini, "
                             "or ~/.config/kaltstart/config.ini)")
    parser.add_argument("-v", "--verbose", action="store_true", help="print the command lines that are run")
    parser.add_argument("--version", action="version", version=__version__)
    commands = parser.add_subparsers(dest="command", metavar="COMMAND", required=True)

    def command(name, func, help_text, token_options=False):
        sub = commands.add_parser(name, help=help_text, description=help_text)
        sub.set_defaults(func=func)
        if token_options:
            sub.add_argument("host", metavar="HOST", help="name of a [host ...] section")
            sub.add_argument("--token", metavar="T", help="name of the [token ...] section to use")
            sub.add_argument("--device", metavar="DEV", help="FIDO2 device, for example /dev/hidraw5 (default: auto-detect)")
        return sub

    sub = command("init", cmd_init, "create a credential on the token and append a [token ...] section")
    sub.add_argument("--token", metavar="NAME", default="main", help="name of the token section (default: main)")
    sub.add_argument("--rp-id", metavar="ID", default="kaltstart", help="relying party ID (default: kaltstart)")
    sub.add_argument("--device", metavar="DEV", help="FIDO2 device (default: auto-detect)")
    sub.add_argument("--no-pin", action="store_true",
                     help="create a credential that is used without the PIN, and write pin = no")

    sub = command("add-host", cmd_add_host, "append a [host ...] section with a new random salt")
    sub.add_argument("name", metavar="NAME", help="name of the new [host ...] section")
    sub.add_argument("--host", metavar="H", required=True, help="host name or address of the server in the initramfs")
    sub.add_argument("--port", metavar="N", default="22", help="SSH port of the initramfs (default: 22)")
    sub.add_argument("--user", metavar="U", default="root", help="login user of the initramfs (default: root)")
    sub.add_argument("--identity", metavar="F", help="SSH private key for the initramfs")
    sub.add_argument("--known-hosts", metavar="F", help="known_hosts file that contains the host key of the initramfs")
    sub.add_argument("--booted-port", metavar="N", help="SSH port of the running system, used to confirm the start")
    sub.add_argument("--token", metavar="T", help="token section used for this host")
    sub.add_argument("--device-on-server", metavar="DEV", action="append",
                     help="LUKS device on the server; may be given several times")

    sub = command("enroll", cmd_enroll, "add the passphrase to the LUKS devices of the running system", token_options=True)
    sub.add_argument("--device-on-server", metavar="DEV", action="append",
                     help="LUKS device on the server; may be given several times")
    sub.add_argument("--existing-keyfile", metavar="PATH_ON_SERVER",
                     help="key file on the server that opens an existing keyslot")

    sub = command("unlock", cmd_unlock, "derive the passphrase and submit it to cryptroot-unlock over SSH",
                  token_options=True)
    sub.add_argument("--wait", metavar="SECONDS", type=seconds, default=600.0,
                     help="time limit for the SSH port of the initramfs (default: 600; 0 = a single attempt)")
    sub.add_argument("--boot-timeout", metavar="SECONDS", type=seconds, default=300.0,
                     help="time limit for booted_port after the unlock (default: 300)")

    sub = command("derive", cmd_derive, "write the passphrase for HOST to standard output", token_options=True)
    sub.add_argument("--allow-tty", action="store_true", help="permit output to a terminal")

    sub = command("check", cmd_check, "validate the local configuration for HOST (the token is not used, no SSH login)")
    sub.add_argument("host", metavar="HOST", help="name of a [host ...] section")

    command("list", cmd_list, "print the configured tokens and hosts")
    return parser


def main(argv=None):
    global VERBOSE
    args = build_parser().parse_args(argv)
    VERBOSE = args.verbose
    args.config = args.config or default_config_path()
    # No core file: it would hold the passphrase. ssh and the fido2 tools
    # inherit the limit.
    try:
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    except (ValueError, OSError):
        pass
    # Treat SIGTERM, SIGHUP and SIGQUIT like Ctrl-C, so that cleanup (the key
    # file that enroll puts on the server, temporary directories) still runs.
    # A signal that was ignored when the program started stays ignored.
    for signum in TERMINATION_SIGNALS:
        if signal.getsignal(signum) is signal.SIG_DFL:
            signal.signal(signum, signal.default_int_handler)
    try:
        status = args.func(args)
        sys.stdout.flush()
        return status
    except Failure as exc:
        say(str(exc))
        return exc.code
    except KeyboardInterrupt:
        say("interrupted")
        return 130
    except BrokenPipeError:
        # The reader of stdout has gone. Point stdout elsewhere, so that the
        # interpreter does not fail a second time when it exits.
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        except (OSError, ValueError):
            pass
        say("the output could not be written (broken pipe)")
        return 1
    except Exception as exc:  # unexpected: one line, traceback only with --verbose
        say(f"internal error: {type(exc).__name__}: {escape_control(str(exc))}")
        if VERBOSE:
            traceback.print_exc()
        return 1


if __name__ == "__main__":
    sys.exit(main())
