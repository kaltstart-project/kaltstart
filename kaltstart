def cmd_init(args):
    config = load_config(args.config)
    name = check_name(args.token, "--token")
    if name in config.tokens:
        raise Failure(EXIT_USAGE, f"[token {name}] already exists in {config.path}")
    rp_id = check_text(args.rp_id, "--rp-id")
    check_writable(config.path)  # before PIN and touch are spent
    tool = find_tool("fido2-cred", EXIT_TOKEN)
    device = pick_device(args.device, None)
    params = [b64(os.urandom(32)), rp_id, "kaltstart", b64(os.urandom(16))]
    argv = [tool, "-M", "-h"]
    if not args.no_pin:
        # With this protection level the token itself refuses to use the
        # credential without user verification. A token that does not know
        # the extension ignores it.
        argv += ["-c", CRED_PROTECT_UV_REQUIRED]
    say(f"creating a credential on {device}: enter the PIN if asked, then touch the token")
    status, output = run_fido_tool(argv, params, device)
    if status != 0:
        raise Failure(EXIT_TOKEN, f"fido2-cred failed with exit status {status}")
    lines = output.decode("ascii", "replace").splitlines()
    values = {"rp_id": rp_id, "credential_id": lines[4].strip() if len(lines) >= 5 else "",
              "pin": "no" if args.no_pin else "yes"}
    try:
        parse_token(name, values)
    except Failure:
        raise Failure(EXIT_TOKEN, "fido2-cred did not print a credential ID on line 5") from None
    append_section(config.path, f"token {name}", values)
    say(f"added [token {name}] to {config.path}")
    unbound = [host for host, raw in config.hosts.items() if not raw.get("token", "").strip()]
    if config.tokens and unbound:
        verb = "has no token key and needs" if len(unbound) == 1 else "have no token key and need"
        say(f"note: the file now has several token sections; [host {'], [host '.join(unbound)}] "
            f"{verb} --token from now on")
    return 0


def cmd_add_host(args):
    config = load_config(args.config)
    name = check_name(args.name, "NAME")
    if name in config.hosts:
        raise Failure(EXIT_USAGE, f"[host {name}] already exists in {config.path}")
    values = {"host": args.host, "port": args.port, "user": args.user}
    # With a single token section the host is tied to it, so that a token
    # added later does not make the choice ambiguous.
    token = args.token or (next(iter(config.tokens)) if len(config.tokens) == 1 else None)
    optional = {"identity": args.identity, "known_hosts": args.known_hosts,
                "booted_port": args.booted_port, "token": token,
                "devices": " ".join(args.device_on_server or [])}
    values.update({key: value for key, value in optional.items() if value})
    values["salt"] = b64(secrets.token_bytes(32))
    for key, value in values.items():
        if CONTROL_RE.search(value):
            raise bad(f"[host {name}] {key}", "must not contain control characters")
    parse_host(name, values)  # validate before anything is written
    if args.token and args.token not in config.tokens:
        raise Failure(EXIT_USAGE, f"no [token {args.token}] section in {config.where()}")
    append_section(config.path, f"host {name}", values)
    say(f"added [host {name}] to {config.path}")
    return 0


def cmd_derive(args):
    if sys.stdout.isatty() and not args.allow_tty:
        raise Failure(EXIT_USAGE, "refusing to write the passphrase to a terminal (use --allow-tty to override)")
    config = load_config(args.config)
    host = config.host(args.host)
    token = config.token_for(host, args.token)
    secret = derive_passphrase(token, host, args.device)
    sys.stdout.buffer.write(secret)
    sys.stdout.buffer.flush()
    return 0


def cmd_unlock(args):
    config = load_config(args.config)
    host = config.host(args.host)
    token = config.token_for(host, args.token)
    ssh = find_tool("ssh", EXIT_SSH)
    find_tool("fido2-assert", EXIT_TOKEN)
    if not (args.device or token.device):
        find_tool("fido2-token", EXIT_TOKEN)  # needed to find the device; report it before the wait

    # 1. Plain TCP probe only: an empty SSH session would count as a failed attempt.
    #    With "probe = no" (host behind a jump host or an ssh config alias)
    #    there is nothing this tool can probe directly, so it does not wait.
    if host.probe:
        say(f"waiting for {host.host} port {host.port}")
        if not wait_for_port(host.host, host.port, args.wait):
            try:
                socket.getaddrinfo(host.host, host.port)
            except OSError as exc:
                raise Failure(EXIT_TIMEOUT, f"{host.host} cannot be resolved ({exc.strerror or exc})") from None
            raise Failure(EXIT_TIMEOUT, f"{host.host} port {host.port} did not open within {args.wait:g} s")
    else:
        say(f"not probing {host.host} port {host.port} (probe = no)")

    # 2. PIN and touch happen here. On failure the server is never contacted.
    secret = derive_passphrase(token, host, args.device)

    # 3. One ssh session per passphrase prompt of the initramfs, at most
    #    "prompts" sessions. cryptroot-unlock prints "Please unlock disk NAME"
    #    right before it reads the passphrase and exits 0 once that device is
    #    open; without that line nothing was read. The loop ends early when no
    #    device is waiting any more or the initramfs has moved on.
    argv = unlock_argv(ssh, host)
    accepted = 0
    unknown = None  # why the outcome of the last session is not known, if so
    for attempt in range(1, host.prompts + 1):
        if accepted and host.probe and not port_open(host.host, host.port):
            say(f"{host.host} port {host.port} is closed: the initramfs has moved on")
            break
        count = f" (submission {attempt} of at most {host.prompts})" if host.prompts > 1 else ""
        say(f"sending the passphrase to {host.host}{count}")
        reply = ssh_run(argv, secret)
        status = reply.status
        prompted = UNLOCK_PROMPT in reply.output
        before = f" after {accepted} accepted submission(s)" if accepted else ""
        if status == 0 and prompted:
            accepted += 1
        elif status == 0:
            if not accepted:
                raise Failure(EXIT_REJECTED, "no device was waiting for a passphrase: the server did not test the "
                              "passphrase (it may have been unlocked by other means)")
            say("no further device is waiting for a passphrase")
            break
        elif transport_failed(status) and not prompted:
            if not accepted:
                # Connection, host key or authentication failed before the
                # remote command ran: there is no boot to wait for.
                cause = reply.ended or "connection, host key or authentication problem"
                raise Failure(EXIT_SSH, f"ssh failed (exit status {status}) before the server asked for the "
                              f"passphrase: {cause}")
            if host.probe and port_open(host.host, host.port):
                raise Failure(EXIT_SSH, f"submission {attempt} could not be delivered (ssh exit status {status})"
                              f"{before}, although {host.host} port {host.port} still answers")
            say("the initramfs no longer answers: it has moved on")
            break
        elif transport_failed(status):
            unknown = f"the ssh connection was lost (exit status {status}) after the passphrase was delivered"
            break
        elif prompted and UNLOCK_GAVE_UP in reply.errors:
            unknown = "cryptroot-unlock stopped waiting for cryptsetup before the result was known"
            break
        elif prompted:
            raise Failure(EXIT_REJECTED, f"passphrase rejected by the server (remote exit status {status}){before}")
        elif accepted:
            unknown = f"the server did not ask for another passphrase (remote exit status {status})"
            break
        else:
            raise Failure(EXIT_REJECTED, f"the server did not take the passphrase (remote exit status {status}, no "
                          "unlock prompt seen): it was probably never tested; see the remote message above and try again")
    secret = None  # not needed any more
    if unknown:
        say(f"{unknown}{' after ' + str(accepted) + ' accepted submission(s)' if accepted else ''}")
    else:
        say("passphrase accepted" if accepted == 1 else f"passphrase accepted ({accepted} submissions)")

    # 4. Optional confirmation through the port of the running system. It may
    #    have an address other than that of the initramfs (two leases), so the
    #    check goes to admin_host. On the same machine and port the SSH
    #    service of the initramfs would answer; nothing can be confirmed then.
    up_host = host.admin_host
    confirm = (host.probe and host.booted_port is not None
               and not (host.booted_port == host.port and same_machine(up_host, host.host)))
    if not confirm:
        if unknown:
            raise Failure(EXIT_SSH if transport_failed(status) else EXIT_REJECTED,
                          "cannot tell whether the server was unlocked (the start cannot be confirmed: no "
                          "booted_port, probe = no, or the same port on the same machine)")
        return 0
    say(f"waiting for {up_host} port {host.booted_port}")
    if wait_for_port(up_host, host.booted_port, args.boot_timeout):
        say(f"{up_host} is up (port {host.booted_port} is open)")
        return 0
    limit = f"{up_host} port {host.booted_port} did not open within {args.boot_timeout:g} s"
    if unknown:
        raise Failure(EXIT_SSH if transport_failed(status) else EXIT_REJECTED, f"{limit}, and {unknown}")
    raise Failure(EXIT_TIMEOUT, limit)


def remove_remote_file(ssh, host, remote_file, certain):
    """Remove the uploaded key file. Says so loudly if that does not work.

    certain tells whether the file is known to exist. The termination
    signals are ignored meanwhile: a second Ctrl-C must not end the removal.
    The ssh defaults bound the time it can take.
    """
    removed = False
    try:
        with signals_ignored():
            removed = ssh_run(admin_argv(ssh, host, as_root(host, "rm -f " + shlex.quote(remote_file)))).status == 0
    finally:
        if not removed and certain:
            say(f"WARNING: COULD NOT REMOVE {remote_file} ON {host.admin_host}. IT CONTAINS THE LUKS "
                f"PASSPHRASE. Remove it by hand: rm -f {shlex.quote(remote_file)}")
        elif not removed:
            say(f"WARNING: could not make sure that {remote_file} does not exist on {host.admin_host}. If it "
                f"exists, it contains the LUKS passphrase. Check by hand: rm -f {shlex.quote(remote_file)}")
    return removed


def keyslot_note(reply):
    """The keyslot number that cryptsetup --verbose reported, for a message."""
    found = KEYSLOT_RE.search(reply.output) or KEYSLOT_RE.search(reply.errors)
    return f" (keyslot {found.group(1).decode()})" if found else ""


def cmd_enroll(args):
    config = load_config(args.config)
    host = config.host(args.host)
    token = config.token_for(host, args.token)
    ssh = find_tool("ssh", EXIT_SSH)
    find_tool("fido2-assert", EXIT_TOKEN)
    if not (args.device or token.device):
        find_tool("fido2-token", EXIT_TOKEN)  # needed to find the device
    devices = [check_server_path(dev, "--device-on-server") for dev in args.device_on_server or []]
    devices = devices or host.devices
    existing = args.existing_keyfile and check_server_path(args.existing_keyfile, "--existing-keyfile")

    def remote(command, **options):
        """An ssh run on the running system, as root."""
        return ssh_run(admin_argv(ssh, host, as_root(host, command)), **options)

    if not devices:
        say(f"LUKS devices on {host.admin_host}:")
        status = remote("blkid -t TYPE=crypto_LUKS -o device").status
        if transport_failed(status):
            raise Failure(EXIT_SSH, f"ssh to {host.admin_host} failed (exit status {status})")
        raise Failure(EXIT_USAGE, f"no LUKS devices configured; set 'devices' in [host {host.name}] "
                      "or pass --device-on-server")

    # 1. Before PIN and touch are spent: the running system must be reachable,
    #    the commands must run without a password prompt, and every device
    #    must be a LUKS device.
    for device in devices:
        status = remote("cryptsetup isLuks " + shlex.quote(device)).status
        if transport_failed(status):
            raise Failure(EXIT_SSH, f"ssh to {host.admin_host} failed (exit status {status})")
        if status != 0:
            raise Failure(EXIT_REJECTED, f"{device} cannot be used on {host.admin_host}: it is not a LUKS device, "
                          f"or the command could not be run as root (exit status {status})")

    # 2. PIN and touch.
    secret = derive_passphrase(token, host, args.device)

    failed = []
    transport = False

    def fail(device, step, status):
        nonlocal transport
        say(f"{device}: failed ({step} exit status {status})")
        failed.append(device)
        transport = transport or transport_failed(status)

    # 3. Which devices lack the passphrase? cryptsetup reads it from stdin,
    #    the way unlock delivers it, so the test does not depend on the key
    #    file of step 4. A passphrase that already opens a device is not added
    #    again: a repeated run must not leave several keyslots with it.
    test = "cryptsetup open --test-passphrase --disable-external-tokens --verbose --key-file - "
    missing = []
    for device in devices:
        say(f"{device}: checking whether a keyslot already opens with this passphrase")
        reply = remote(test + shlex.quote(device), secret=secret, echo=False)
        if reply.status == 0:
            say(f"{device}: already enrolled{keyslot_note(reply)}")
        elif reply.status == CRYPTSETUP_NO_KEY:
            missing.append(device)
        else:
            echo_remote(reply.output)
            fail(device, "the check ended with", reply.status)

    # 4. Add a keyslot where it is missing, and verify it.
    remote_file = "/run/kaltstart-enroll-" + secrets.token_hex(8)
    quoted = shlex.quote(remote_file)
    uploaded = stored = False
    try:
        if missing and not existing:
            # cryptsetup asks for an existing passphrase on the terminal, so
            # the new one cannot come from stdin. It is put into a file that
            # only root can read, and the file is compared with what was sent
            # before a keyslot is made from it.
            upload = f"umask 077 && cat > {quoted}"
            if host.admin_sudo:
                upload = "sudo -n sh -c " + shlex.quote(upload)
            uploaded = True
            status = ssh_run(admin_argv(ssh, host, upload), secret).status
            if status != 0:
                raise Failure(EXIT_SSH, f"uploading the key file to {host.admin_host} failed (ssh exit status {status})")
            stored = True
            reply = remote(f"sha256sum {quoted}", echo=False)
            if reply.status != 0 or reply.output.split()[:1] != [hashlib.sha256(secret).hexdigest().encode("ascii")]:
                raise Failure(EXIT_SSH, f"the key file on {host.admin_host} does not hold the passphrase that was "
                              "sent; no keyslot was added")
        for device in missing:
            target = shlex.quote(device)
            say(f"{device}: none yet, adding a keyslot")
            if existing:
                add = f"cryptsetup luksAddKey --key-file {shlex.quote(existing)} --new-keyfile - {target}"
                status = remote(add, secret=secret).status
            else:
                add = as_root(host, f"cryptsetup luksAddKey --new-keyfile {quoted} {target}", interactive=True)
                status = ssh_terminal(admin_argv(ssh, host, add, tty=True))
            if status != 0:
                fail(device, "luksAddKey", status)
                continue
            say(f"{device}: added")
            reply = remote(test + target, secret=secret, echo=False)
            if reply.status != 0:
                echo_remote(reply.output)
                fail(device, "verification", reply.status)
                continue
            say(f"{device}: verified{keyslot_note(reply)}")
    finally:
        removed = not uploaded or remove_remote_file(ssh, host, remote_file, stored)
    if not removed:
        raise Failure(EXIT_SSH, "the key file may still be on the server"
                      + (f"; enrollment failed for: {', '.join(failed)}" if failed else ""))
    if failed:
        raise Failure(EXIT_SSH if transport else EXIT_REJECTED, "enrollment failed for: " + ", ".join(failed))
    say(f"enrollment complete for {len(devices)} device(s)"
        + ("; the key file was removed from the server" if uploaded else ""))
    return 0


def cmd_check(args):
    """Local checks only: the token is not used and no SSH login takes place."""
    passed = []

    def report(ok, text):
        passed.append(bool(ok))
        say(("ok:   " if ok else "FAIL: ") + text)

    try:
        _, problem = access_problem(os.stat(args.config))
        report(not problem, f"configuration file {args.config}" + (f" {problem}" if problem else ""))
        directory = os.path.dirname(args.config) or "."
        if stat.S_IMODE(os.stat(directory).st_mode) & 0o022:
            report(False, f"directory {directory} is writable by group or others")
    except OSError as exc:
        report(False, f"configuration file {args.config}: {exc.strerror}")
    for tool in ("fido2-assert", "fido2-token", "ssh", "ssh-keygen"):
        report(shutil.which(tool), f"executable {tool}")

    host = None
    try:
        config = load_config(args.config, warn=False)
        host = config.host(args.host)
        report(True, f"[host {host.name}] is valid")
    except Failure as exc:
        report(False, str(exc))
    if host is None:
        return EXIT_USAGE
    try:
        report(True, f"[token {config.token_for(host, None).name}] is valid")
    except Failure as exc:
        report(False, str(exc))
    if host.identity:
        report(os.path.isfile(host.identity), f"identity file {host.identity}")
    if host.known_hosts:
        report(os.path.isfile(host.known_hosts), f"known_hosts file {host.known_hosts}")

    lookup = host.host if host.port == 22 else f"[{host.host}]:{host.port}"
    keygen = shutil.which("ssh-keygen")
    if keygen:
        argv = [keygen, "-F", lookup] + (["-f", host.known_hosts] if host.known_hosts else [])
        show_command(argv)
        found = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL).returncode == 0
        report(found, f"known_hosts entry for {lookup}")
    others = hosts_with_salt_of(config, host.name)
    if others:
        say(f"note: [host {host.name}] has the same salt as [host {'], [host '.join(others)}]; with the same "
            "token they share one passphrase, which is intended only for sections that describe the same server")
    return 0 if all(passed) else EXIT_USAGE


def cmd_list(args):
    config = load_config(args.config)

    def short(text):
        return text if len(text) <= 12 else text[:8] + "..."

    for name in config.tokens:
        token = config.token(name)
        print(f"token {name}: rp_id={escape_control(token.rp_id)} credential_id={short(token.credential_id)} "
              f"pin={'yes' if token.pin else 'no'} device={escape_control(token.device or 'auto')}")
    reported = set()
    for name in config.hosts:
        host = config.host(name)
        if host.token:
            config.token(host.token)  # the section must exist and be valid
        booted = f" booted_port={host.booted_port}" if host.booted_port else ""
        booted += "" if host.probe else " probe=no"
        print(f"host {name}: {host.user}@{host.host} port={host.port}{booted} token={host.token or '(not set)'} "
              f"salt={short(host.salt)} prompts={host.prompts} devices={','.join(host.devices) or 'none'}")
        others = hosts_with_salt_of(config, name)
        if others and name not in reported:
            reported.update(others)
            say(f"warning: [host {name}] and [host {'], [host '.join(others)}] have the same salt; with the same "
                "token they share one passphrase, which is intended only for sections that describe the same server")
    return 0


