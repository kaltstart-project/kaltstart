TOKEN_KEYS = {"rp_id", "credential_id", "pin", "device"}
HOST_KEYS = {
    # initramfs connection
    "host", "port", "user", "salt", "token", "identity", "known_hosts", "remote_command",
    "prompts", "probe", "booted_port", "ssh_options",
    # running system
    "admin_host", "admin_port", "admin_user", "admin_sudo", "admin_ssh_options", "devices",
}


@dataclass
class Token:
    name: str
    rp_id: str
    credential_id: str
    pin: bool
    device: Optional[str]


@dataclass
class Host:
    name: str
    host: str
    port: int
    user: str
    identity: Optional[str]
    known_hosts: Optional[str]
    salt: str
    token: Optional[str]
    remote_command: str
    prompts: int
    booted_port: Optional[int]
    probe: bool
    ssh_options: List[str]
    admin_host: str
    admin_port: Optional[int]
    admin_user: str
    admin_sudo: bool
    admin_ssh_options: List[str]
    devices: List[str]


class Section:
    """Typed access to the raw key/value pairs of one config section."""

    def __init__(self, header, raw, known_keys):
        self.header = f"[{header}]"
        self.raw = raw
        for key in raw:
            if key not in known_keys:
                raise bad(f"{self.header} {escape_control(key)}", "unknown key")

    def get(self, key, check, default=None, *extra):
        value = self.raw.get(key, "").strip()
        if not value:
            return default
        return check(value, f"{self.header} {key}", *extra)

    def need(self, key, check, *extra):
        value = self.get(key, check, None, *extra)
        if value is None:
            raise bad(f"{self.header} {key}", "required key is missing")
        return value


def parse_token(name, raw):
    sec = Section(f"token {name}", raw, TOKEN_KEYS)
    credential_id = sec.need("credential_id", lambda v, w: (check_b64(v, w), v)[1])
    return Token(
        name=name,
        rp_id=sec.get("rp_id", check_text, "kaltstart"),
        credential_id=credential_id,
        pin=sec.get("pin", check_bool, True),
        device=sec.get("device", check_text),
    )


def parse_host(name, raw):
    sec = Section(f"host {name}", raw, HOST_KEYS)
    host = sec.need("host", check_host)
    devices = [check_server_path(dev, f"{sec.header} devices")
               for dev in re.split(r"[,\s]+", raw.get("devices", "")) if dev]
    return Host(
        name=name,
        host=host,
        port=sec.get("port", check_port, 22),
        user=sec.get("user", check_user, "root"),
        identity=sec.get("identity", check_local_path),
        known_hosts=sec.get("known_hosts", check_local_path),
        salt=sec.need("salt", lambda v, w: (check_b64(v, w, 32), v)[1]),
        token=sec.get("token", check_name),
        remote_command=sec.get("remote_command", check_text, "cryptroot-unlock"),
        prompts=sec.get("prompts", check_int, 1, 1, 1000),
        booted_port=sec.get("booted_port", check_port),
        probe=sec.get("probe", check_bool, True),
        ssh_options=sec.get("ssh_options", check_options, []),
        admin_host=sec.get("admin_host", check_host, host),
        admin_port=sec.get("admin_port", check_port),
        admin_user=sec.get("admin_user", check_user, "root"),
        admin_sudo=sec.get("admin_sudo", check_bool, False),
        admin_ssh_options=sec.get("admin_ssh_options", check_options, []),
        devices=devices,
    )


class Config:
    """The parsed configuration file. Sections are validated when they are used."""

    def __init__(self, path):
        self.path = path
        self.missing = False  # the file does not exist
        self.tokens = {}  # name -> raw dict
        self.hosts = {}   # name -> raw dict

    def where(self):
        return f"{self.path} (the file does not exist)" if self.missing else self.path

    def token(self, name):
        if name not in self.tokens:
            raise Failure(EXIT_USAGE, f"no [token {name}] section in {self.where()}")
        return parse_token(name, self.tokens[name])

    def host(self, name):
        if name not in self.hosts:
            raise Failure(EXIT_USAGE, f"no [host {name}] section in {self.where()}")
        return parse_host(name, self.hosts[name])

    def token_for(self, host, override):
        """--token, else the host's token key, else the only token section."""
        name = override or host.token
        if name is None:
            if not self.tokens:
                raise Failure(EXIT_USAGE, f"no [token ...] section in {self.where()}; create one with 'kaltstart init'")
            if len(self.tokens) != 1:
                raise Failure(EXIT_USAGE, f"[host {host.name}] names no token and {self.where()} has "
                              f"{len(self.tokens)} token sections; set the token key of the host or use --token")
            name = next(iter(self.tokens))
        return self.token(name)


def default_config_path():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "kaltstart", "config.ini")


def access_problem(status):
    """Judge owner and mode of the configuration file from its stat result.

    Returns (refuse, text). The file is refused if someone else can change
    it: its content decides where the passphrase is sent and which ssh
    options are used. Read access for others only earns a warning.
    """
    mode = stat.S_IMODE(status.st_mode)
    if status.st_uid not in (os.geteuid(), 0):
        return True, "is owned by another user"
    if mode & 0o022:
        return True, f"is writable by group or others (mode {mode:04o})"
    if mode & 0o077:
        return False, f"is accessible by group or others (mode {mode:04o})"
    return False, None


def load_config(path, warn=True):
    config = Config(path)
    # Without a default section "[DEFAULT]" is a section like any other and
    # is refused below; configparser would copy its keys into every section.
    parser = configparser.ConfigParser(interpolation=None, default_section="")
    try:
        with open(path, encoding="utf-8") as handle:
            refuse, problem = access_problem(os.fstat(handle.fileno()))
            if refuse:
                raise Failure(EXIT_USAGE, f"{path} {problem}; refusing to use it (chmod 600 {shlex.quote(path)})")
            parser.read_file(handle)
        if warn and problem:
            say(f"warning: {path} {problem}; run: chmod 600 {shlex.quote(path)}")
    except FileNotFoundError:
        config.missing = True
        return config
    except (OSError, UnicodeError, configparser.Error) as exc:
        raise Failure(EXIT_USAGE, f"cannot read {path}: {escape_control(str(exc))}") from None
    for section in parser.sections():
        parts = section.split()
        if len(parts) != 2 or parts[0] not in ("token", "host"):
            raise bad(f"[{escape_control(section)}]", "unknown section (expected [token NAME] or [host NAME])")
        check_name(parts[1], f"[{escape_control(section)}]")
        target = config.tokens if parts[0] == "token" else config.hosts
        if parts[1] in target:
            raise bad(f"[{escape_control(section)}]", "section is defined twice")
        target[parts[1]] = dict(parser.items(section))
    return config


def hosts_with_salt_of(config, name):
    """Names of the other host sections that use the same salt as host NAME.

    With the same token such sections yield the same passphrase. That is
    intended only if they describe the same server.
    """
    salt = config.hosts[name].get("salt", "").strip()
    return [other for other, raw in config.hosts.items()
            if other != name and salt and raw.get("salt", "").strip() == salt]


def check_writable(path):
    """Fail early if the configuration file cannot be created or extended."""
    probe = path
    while not os.path.exists(probe):
        probe = os.path.dirname(probe) or "."
    need = os.W_OK | (os.X_OK if os.path.isdir(probe) else 0)
    if not os.access(probe, need):
        raise Failure(EXIT_USAGE, f"cannot write {path}: no write permission for {probe}")


def append_section(path, header, values):
    """Append one new section. Existing content is never rewritten."""
    text = f"[{header}]\n" + "".join(f"{key} = {value}\n" for key, value in values.items())
    try:
        os.makedirs(os.path.dirname(path) or ".", mode=0o700, exist_ok=True)
        fd = os.open(path, os.O_RDWR | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "r+b") as handle:
            old = handle.read()
            if old:
                text = ("\n" if old.endswith(b"\n") else "\n\n") + text
            handle.write(text.encode("utf-8"))
    except OSError as exc:
        raise Failure(EXIT_USAGE, f"cannot write {path}: {exc.strerror}") from None


# --------------------------------------------------------------------------
# Token (fido2-tools)
# --------------------------------------------------------------------------

def find_tool(name, code):
    path = shutil.which(name)
    if not path:
        hint = " (install fido2-tools)" if name.startswith("fido2-") else ""
        raise Failure(code, f"{name} not found in PATH{hint}")
    return path


def detect_device():
    """Return the only FIDO2 device listed by 'fido2-token -L'."""
    argv = [find_tool("fido2-token", EXIT_TOKEN), "-L"]
    show_command(argv)
    proc = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE)
    if proc.returncode != 0:
        raise Failure(EXIT_TOKEN, f"fido2-token -L failed with exit status {proc.returncode}")
    # Line format: "/dev/hidraw5: vendor=0x1050, product=0x0407 (Yubico YubiKey ...)"
    lines = [line for line in proc.stdout.decode("utf-8", "replace").splitlines() if ": vendor=" in line]
    devices = [line.split(": vendor=", 1)[0].strip() for line in lines]
    if len(devices) == 1:
        return devices[0]
    if not devices:
        raise Failure(EXIT_TOKEN, "no FIDO2 device found; plug in the token or pass --device")
    for line in lines:
        say("found: " + escape_control(line))
    raise Failure(EXIT_TOKEN, f"{len(devices)} FIDO2 devices found; choose one with --device")


def pick_device(option, token):
    device = option or (token.device if token else None) or detect_device()
    if not device or device.startswith("-") or CONTROL_RE.search(device):
        raise Failure(EXIT_TOKEN, "invalid FIDO2 device path")
    return device


def run_fido_tool(argv, params, device):
    """Run a fido2 tool with a parameter file and return (exit status, stdout).

    The parameter file is not secret. It lives in a private temporary
    directory that is removed afterwards. stdin and stderr are inherited so
    the tool can ask for the PIN on the terminal.
    """
    with tempfile.TemporaryDirectory(prefix="kaltstart-") as directory:
        param_file = os.path.join(directory, "params")
        fd = os.open(param_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write("".join(line + "\n" for line in params))
        argv = argv + ["-i", param_file, device]
        show_command(argv)
        proc = subprocess.run(argv, stdout=subprocess.PIPE)
    return proc.returncode, proc.stdout


def is_hmac_secret(candidate):
    """True if candidate (bytes) is strict base64 of exactly 32 bytes."""
    if len(candidate) != SECRET_LENGTH:
        return False
    try:
        raw = base64.b64decode(candidate, validate=True)
    except ValueError:
        return False
    return len(raw) == 32 and base64.b64encode(raw) == candidate


def derive_passphrase(token, host, device_option):
    """Ask the token for the hmac-secret value. Returns the passphrase as 44 ASCII bytes."""
    tool = find_tool("fido2-assert", EXIT_TOKEN)
    device = pick_device(device_option, token)
    argv = [tool, "-G", "-h", "-t", "up=true"]
    if token.pin:
        argv += ["-t", "pin=true"]
    client_data_hash = b64(os.urandom(32))
    params = [client_data_hash, token.rp_id, token.credential_id, host.salt]
    say(f"asking token '{token.name}' on {device}: enter the PIN if asked, then touch the token")
    status, output = run_fido_tool(argv, params, device)
    if status != 0:
        raise Failure(EXIT_TOKEN, f"fido2-assert failed with exit status {status}")
    lines = [line.strip() for line in output.split(b"\n") if line.strip()]
    secret = lines[-1] if lines else b""
    # The first output line echoes the client data hash of the request, which
    # is also base64 of 32 bytes: never mistake a truncated output for the secret.
    if not is_hmac_secret(secret) or secret == client_data_hash.encode("ascii"):
        raise Failure(EXIT_TOKEN, "the token returned no usable hmac-secret value")
    return secret


# --------------------------------------------------------------------------
# SSH transport
# --------------------------------------------------------------------------

def port_open(host, port):
    try:
        socket.create_connection((host, port), timeout=CONNECT_TIMEOUT).close()
        return True
    except OSError:
        return False


def wait_for_port(host, port, seconds):
    """Plain TCP probe, retried until the deadline. seconds == 0 means one attempt."""
    deadline = time.monotonic() + seconds
    while True:
        if port_open(host, port):
            return True
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False
        time.sleep(min(RETRY_INTERVAL, remaining))


def same_machine(first, second):
    """True if two host names or addresses are equal or resolve to a common address."""
    if first.rstrip(".").lower() == second.rstrip(".").lower():
        return True
    try:
        found = [{info[4][0] for info in socket.getaddrinfo(name, None)} for name in (first, second)]
    except OSError:
        return False
    return bool(found[0] & found[1])


# Options that precede everything the user can configure. ssh uses the first
# value it obtains for an option, so these cannot be overridden by ssh_options
# or by the user's ssh configuration. The host key must be known beforehand
# and is checked by this very ssh process: no key is accepted on trust, none
# is learned from the server or from DNS, and no connection opened earlier
# under other rules is shared. The session offers the remote side neither the
# agent nor the X11 display nor a port forwarding.
FORCED_SSH_OPTIONS = ["-o", "StrictHostKeyChecking=yes", "-o", "UpdateHostKeys=no", "-o", "VerifyHostKeyDNS=no",
                      "-o", "ControlMaster=no", "-o", "ControlPath=none",
                      "-o", "ForwardAgent=no", "-o", "ForwardX11=no", "-o", "ClearAllForwardings=yes"]
# In addition for the initramfs, which only ever takes a key: a server that
# is not the genuine one must not be able to show a prompt of its own.
INITRAMFS_SSH_OPTIONS = ["-o", "PasswordAuthentication=no", "-o", "KbdInteractiveAuthentication=no"]
# Defaults that follow the configured options and yield to them: a connection
# attempt and a session that no longer answers end after a bounded time.
DEFAULT_SSH_OPTIONS = ["-o", "ConnectTimeout=15", "-o", "ServerAliveInterval=10", "-o", "ServerAliveCountMax=3"]


def unlock_argv(ssh, host):
    """ssh command line for the initramfs. All options precede the destination."""
    argv = [ssh, "-T", "-p", str(host.port)] + FORCED_SSH_OPTIONS + INITRAMFS_SSH_OPTIONS
    if host.known_hosts:
        # The dedicated file is then the only source of host keys.
        argv += ["-o", f"UserKnownHostsFile={host.known_hosts}", "-o", "GlobalKnownHostsFile=/dev/null"]
    if host.identity:
        argv += ["-o", "IdentitiesOnly=yes", "-i", host.identity]
    # "--" ends the options: ssh reads nothing after the destination as an option.
    return argv + host.ssh_options + DEFAULT_SSH_OPTIONS + ["--", f"{host.user}@{host.host}", host.remote_command]


def admin_argv(ssh, host, remote_command, tty=False):
    """ssh command line for the running system.

    Identity, known_hosts and, unless admin_port is set, the port come from
    the user's ssh configuration. The forced options apply here as well: the
    passphrase travels over this connection during enrollment.
    """
    # With a terminal, "-e none" switches off the "~" escape character: an
    # existing passphrase that starts with "~" must reach cryptsetup unchanged.
    argv = [ssh] + (["-t", "-e", "none"] if tty else ["-T"])
    if host.admin_port:
        argv += ["-p", str(host.admin_port)]
    return (argv + FORCED_SSH_OPTIONS + host.admin_ssh_options + DEFAULT_SSH_OPTIONS
            + ["--", f"{host.admin_user}@{host.admin_host}", remote_command])


def as_root(host, command, interactive=False):
    """Prefix a remote command with sudo when the admin user is not root.

    Without a terminal sudo must not ask for a password ("-n"): it would wait
    for input that never comes.
    """
    if not host.admin_sudo:
        return command
    return ("sudo " if interactive else "sudo -n ") + command


def echo_remote(output):
    for line in output.decode("utf-8", "replace").splitlines():
        say("remote: " + escape_control(line))


@dataclass
class Reply:
    """What an ssh run without a terminal returned. Both texts are free of the passphrase."""
    status: int
    output: bytes  # stdout of the remote command
    errors: bytes  # stderr: messages of ssh itself and of the remote command
    ended: Optional[str] = None  # why this program ended the run, if it did


def relay_errors(stream, secret, collected):
    """Print what ssh writes to its standard error while it runs.

    That is ssh's own output and the standard error of the remote command.
    Every line is printed as it arrives, with control characters escaped and
    the passphrase removed, and is kept in collected up to OUTPUT_LIMIT. A
    line longer than LINE_LIMIT is printed in pieces; the end of a piece is
    held back, so that a passphrase that spans two pieces is still found.
    """
    kept = 0
    held = b""
    with stream:
        while True:
            piece = stream.readline(LINE_LIMIT)
            data = held + piece
            if secret:
                data = data.replace(secret, REDACTED)
            complete = not piece or piece.endswith(b"\n")
            keep = 0 if complete or not secret else min(len(secret) - 1, len(data))
            line, held = data[:len(data) - keep], data[len(data) - keep:]
            if line:
                if kept < OUTPUT_LIMIT:
                    collected.append(line)
                    kept += len(line)
                say("ssh: " + escape_control(line.decode("utf-8", "replace").rstrip("\r\n")))
            if not piece:
                break


def exchange(proc, secret):
    """Give ssh its input, read its stdout and wait for it. Returns (stdout, problem).

    problem is None, or the reason why the run was ended: it took longer than
    SESSION_LIMIT, or the remote side sent more than OUTPUT_LIMIT bytes.
    """
    if secret is not None:
        try:
            proc.stdin.write(secret)
            proc.stdin.close()
        except OSError:
            pass  # ssh has exited already; its exit status tells why
    deadline = time.monotonic() + SESSION_LIMIT
    late = f"no result within {SESSION_LIMIT:g} s"
    descriptor = proc.stdout.fileno()
    chunks, size, problem = [], 0, None
    while problem is None:
        remaining = deadline - time.monotonic()
        if remaining <= 0 or not select.select([descriptor], [], [], remaining)[0]:
            problem = late
            break
        chunk = os.read(descriptor, 65536)
        if not chunk:
            break
        size += len(chunk)
        if size > OUTPUT_LIMIT:
            problem = "the remote side sent more output than this program accepts"
        else:
            chunks.append(chunk)
    if problem is None:
        try:
            proc.wait(max(0.0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            problem = late
    if problem is not None:
        proc.kill()
    proc.wait()
    proc.stdout.close()
    return b"".join(chunks), problem


def ssh_run(argv, secret=None, echo=True):
    """Run ssh without a terminal and return a Reply.

    The secret, if there is one, is the entire stdin (no newline); otherwise
    stdin is empty. Nothing that ssh or the remote side sends reaches the
    terminal unfiltered: control characters are escaped, and a remote side
    that echoes its stdin does not get the secret printed. With echo=False
    the stdout of the remote command is returned but not printed.
    """
    show_command(argv)
    read_fd, write_fd = os.pipe()
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL if secret is None else subprocess.PIPE,
                                stdout=subprocess.PIPE, stderr=write_fd)
    except BaseException:
        os.close(read_fd)
        raise
    finally:
        os.close(write_fd)
    errors = []
    relay = threading.Thread(target=relay_errors, args=(os.fdopen(read_fd, "rb"), secret, errors), daemon=True)
    relay.start()
    try:
        output, problem = exchange(proc, secret)
    except BaseException:
        # Also on Ctrl-C and on a signal: ssh must not go on and deliver the
        # secret after this program has given up.
        proc.kill()
        proc.wait()
        raise
    # A process started by ssh can keep the pipe open after ssh has exited.
    relay.join(RELAY_GRACE)
    if problem:
        say(f"ssh was ended: {problem}")
    if secret:
        output = output.replace(secret, REDACTED)
    if echo:
        echo_remote(output)
    return Reply(proc.returncode, output, b"".join(errors), problem)


def ssh_terminal(argv):
    """Run ssh with a terminal and return the exit status.

    Used for the one step in which cryptsetup asks for an existing
    passphrase. The session is interactive; its output is not filtered.
    """
    show_command(argv)
    return subprocess.run(argv, stdout=2).returncode


@contextlib.contextmanager
def signals_ignored():
    """Ignore the termination signals while a cleanup step runs."""
    previous = {signum: signal.signal(signum, signal.SIG_IGN) for signum in TERMINATION_SIGNALS}
    try:
        yield
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)


def transport_failed(status):
    return status == 255 or status < 0


